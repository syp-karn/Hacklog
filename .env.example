# Copy to `.env` and fill in. `.env` is gitignored; this example is not.
#
# Generate fresh values with:  node analytics-worker/scripts/new-secrets.mjs

# ── Analytics ────────────────────────────────────────────────────────────────
# Origin of the deployed analytics Worker. On workers.dev that is
# https://<worker-name>.<your-subdomain>.workers.dev
PUBLIC_ANALYTICS_ORIGIN=https://replace-with-your-worker-host

# Secret collect path — must be byte-identical to the worker's COLLECT_PATH
# secret. Keep it out of this repo, out of your README, and out of screenshots.
PUBLIC_ANALYTICS_COLLECT_PATH=/replace_with_32_hex_chars

# ── Preview / staging builds only (leave unset for the real site) ────────────
# Set to 1 on any deployment that is not production so search engines ignore it.
# PUBLIC_NOINDEX=1
