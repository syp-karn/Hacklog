---
interface Props {
  cve?: string;
  severity?: "critical" | "high" | "medium" | "low" | "informational";
  cvssScore?: number;
  affectedVersions?: string;
  status?: "draft" | "researching" | "reported" | "disclosed" | "patched" | "wontfix";
  vendor?: string;
  references?: string[];
}

const {
  cve,
  severity,
  cvssScore,
  affectedVersions,
  status,
  vendor,
  references = [],
} = Astro.props;

const severityBadgeClasses: Record<string, string> = {
  critical: "bg-red-500/10 text-red-400 border-red-500/20",
  high: "bg-orange-500/10 text-orange-400 border-orange-500/20",
  medium: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  low: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  informational: "bg-slate-500/10 text-slate-400 border-slate-500/20",
};

const statusBadgeClasses: Record<string, string> = {
  patched: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  disclosed: "bg-sky-500/10 text-sky-400 border-sky-500/20",
  reported: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  researching: "bg-violet-500/10 text-violet-400 border-violet-500/20",
  wontfix: "bg-red-500/10 text-red-400 border-red-500/20",
  draft: "bg-slate-500/10 text-slate-400 border-slate-500/20",
};
---

<div class="my-6 p-4 rounded-xl border border-border bg-card/80 backdrop-blur-sm space-y-4">
  <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-border">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-muted-foreground">
        CVE Metadata
      </span>
      {cve && (
        <span class="font-mono text-xs px-2 py-0.5 rounded bg-muted text-primary font-semibold">
          {cve}
        </span>
      )}
    </div>

    <div class="flex items-center gap-2">
      {severity && (
        <span
          class={`font-mono text-[11px] font-bold uppercase px-2 py-0.5 rounded border ${
            severityBadgeClasses[severity] || "bg-muted text-muted-foreground"
          }`}
        >
          {severity} {cvssScore !== undefined && `(${cvssScore})`}
        </span>
      )}
      {status && (
        <span
          class={`font-mono text-[11px] font-bold uppercase px-2 py-0.5 rounded border ${
            statusBadgeClasses[status] || "bg-muted text-muted-foreground"
          }`}
        >
          {status}
        </span>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-sans">
    {vendor && (
      <div>
        <span class="text-muted-foreground block font-mono text-[10px] uppercase">Vendor / Product</span>
        <span class="font-medium text-foreground">{vendor}</span>
      </div>
    )}
    {affectedVersions && (
      <div>
        <span class="text-muted-foreground block font-mono text-[10px] uppercase">Affected Versions</span>
        <span class="font-mono text-foreground">{affectedVersions}</span>
      </div>
    )}
  </div>

  {references.length > 0 && (
    <div class="pt-2 border-t border-border/50">
      <span class="text-muted-foreground block font-mono text-[10px] uppercase mb-1">References</span>
      <ul class="space-y-1 text-xs">
        {references.map((ref) => (
          <li>
            <a
              href={ref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline font-mono truncate block text-[11px]"
            >
              {ref}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
