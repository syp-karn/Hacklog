---
import ThemeToggle from "@/components/ThemeToggle.astro";
import SidebarNav from "@/components/SidebarNav";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<div class="flex flex-col h-full px-4 py-6 gap-2">
  <!-- Wordmark -->
  <div class="px-2 mb-4">
    <a
      href="/"
      class="block font-mono font-bold text-xl tracking-tight text-primary hover:opacity-80 transition-opacity"
      aria-label="Hacklog home"
    >
      HACKLOG
    </a>
    <p class="text-[11px] text-muted-foreground mt-0.5 font-mono tracking-wider uppercase">
      Cybersecurity
    </p>
  </div>

  <!-- Collapsible nav (React island — hydrated on load) -->
  <SidebarNav currentPath={currentPath} client:load />

  <!-- Bottom bar: theme toggle -->
  <div class="flex items-center gap-2 px-2 pt-4 border-t border-[var(--sidebar-border)]">
    <ThemeToggle />
  </div>
</div>
