---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Search"
  description="Search writeups, security research, CVEs, notes, project logs, and tools across Hacklog."
>
  <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
          DISCOVERY
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Search Publications
      </h1>
      <p class="mt-2 text-muted-foreground leading-relaxed text-sm">
        Full-text static index across Writeups, Research, Notes, Project Logs, and Projects.
      </p>
    </header>

    <!-- Pagefind container -->
    <div id="search-container" class="min-h-[300px]">
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <script src="/pagefind/pagefind-ui.js" is:inline></script>

      <div id="search"></div>

      <script is:inline>
        window.addEventListener("DOMContentLoaded", () => {
          if (typeof PagefindUI !== "undefined") {
            new PagefindUI({
              element: "#search",
              showSubResults: true,
              showImages: false,
              highlightParam: "highlight",
            });
          }
        });
      </script>
    </div>
  </div>
</Layout>
