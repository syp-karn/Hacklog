---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/utils";

const research = await getCollection("research", ({ data }) => !data.draft);
const sortedResearch = research.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allTags = [...new Set(research.flatMap((r) => r.data.tags))];

const typeBadgeClasses: Record<string, string> = {
  cve: "bg-red-500/10 text-red-400 border-red-500/20",
  analysis: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  experiment: "bg-violet-500/10 text-violet-400 border-violet-500/20",
  disclosure: "bg-sky-500/10 text-sky-400 border-sky-500/20",
  research: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
};
---

<Layout
  title="Security Research"
  description="Vulnerability research, CVE disclosures, technical security investigations, and protocol analysis."
>
  <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
          RESEARCH
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Security Research & CVEs
      </h1>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        Original vulnerability research, CVE disclosures, deep dives into security protocols, 
        authentication mechanisms, and security experiments.
      </p>
    </header>

    <!-- Tag Cloud -->
    {allTags.length > 0 && (
      <div class="mb-8 p-4 rounded-xl border border-border bg-card/60">
        <span class="text-xs font-mono font-semibold uppercase text-muted-foreground block mb-2">
          Filter by Tag
        </span>
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="font-mono text-xs px-2.5 py-1 bg-muted/60 hover:bg-primary/20 hover:text-primary rounded-md text-muted-foreground transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- List -->
    {sortedResearch.length === 0 ? (
      <div class="p-12 text-center border border-dashed border-border rounded-xl">
        <p class="text-muted-foreground text-sm">No research articles published yet.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {sortedResearch.map((post) => {
          const { title, date, summary, tags, type, cve, severity, cvssScore } = post.data;
          return (
            <a
              href={`/research/${post.id}`}
              class="group block p-5 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-card/80 transition-all"
            >
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2 flex-wrap">
                  <span
                    class={`font-mono text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded border ${
                      typeBadgeClasses[type] || "bg-muted text-muted-foreground"
                    }`}
                  >
                    {type}
                  </span>
                  {cve && (
                    <span class="font-mono text-xs text-primary font-semibold">
                      {cve}
                    </span>
                  )}
                  {severity && (
                    <span class="font-mono text-[10px] uppercase text-muted-foreground">
                      · {severity} {cvssScore ? `(${cvssScore})` : ""}
                    </span>
                  )}
                </div>
                <time datetime={date} class="text-xs font-mono text-muted-foreground tabular-nums">
                  {formatDate(date)}
                </time>
              </div>

              <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">
                {title}
              </h2>

              <p class="mt-2 text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2">
                {summary}
              </p>

              {tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                    <span class="font-mono text-[10px] px-2 py-0.5 bg-muted/60 rounded text-muted-foreground">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
