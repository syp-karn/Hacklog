---
export const prerender = true;

import ArticleLayout from "@/layouts/ArticleLayout.astro";
import CveMetadata from "@/components/CveMetadata.astro";
import { getCollection, render } from "astro:content";
import { mdxComponents } from "@/mdx-components";

export async function getStaticPaths() {
  const posts = await getCollection("research", ({ data }) => !data.draft);
  const sortedPosts = [...posts].sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost:
        index < sortedPosts.length - 1
          ? { id: sortedPosts[index + 1].id, title: sortedPosts[index + 1].data.title }
          : null,
      nextPost:
        index > 0
          ? { id: sortedPosts[index - 1].id, title: sortedPosts[index - 1].data.title }
          : null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const {
  title,
  date,
  summary,
  tags,
  type,
  cve,
  severity,
  cvssScore,
  affectedVersions,
  status,
  vendor,
  references,
} = post.data;

const { Content, headings } = await render(post);

const isCve = type === "cve" || cve;
---

<ArticleLayout
  title={title}
  date={date}
  summary={summary}
  typeBadge="RESEARCH"
  typeBadgeColor="bg-amber-500/10 text-amber-400 border-amber-500/20"
  tags={tags}
  metaInfo={cve ? `${type.toUpperCase()} · ${cve}` : type.toUpperCase()}
  headings={headings}
  previousPost={previousPost}
  nextPost={nextPost}
  basePath="/research"
>
  {/* Render CVE metadata box if CVE fields are present */}
  {isCve && (
    <CveMetadata
      slot="metadata"
      cve={cve}
      severity={severity}
      cvssScore={cvssScore}
      affectedVersions={affectedVersions}
      status={status}
      vendor={vendor}
      references={references}
    />
  )}

  <Content components={mdxComponents} />
</ArticleLayout>
