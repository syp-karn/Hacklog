---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { PROJECTS, getProjectBySlug } from "@/data/projects";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect("/404");
}

// Fetch any project logs related to this project
const logs = await getCollection(
  "project-logs",
  ({ data }) => data.project === project.slug && !data.draft
);
const sortedLogs = logs.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title={project.title} description={project.description}>
  <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">
    <!-- Back link -->
    <div class="mb-6">
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors py-1 px-2.5 rounded-md border border-border bg-card"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to Projects
      </a>
    </div>

    <!-- Header -->
    <header class="mb-8 border-b border-border pb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
          PROJECT
        </span>
        <span class="font-mono text-xs uppercase text-muted-foreground">
          · {project.status}
        </span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {project.title}
      </h1>

      <p class="mt-3 text-base text-muted-foreground leading-relaxed">
        {project.description}
      </p>

      <!-- Links -->
      <div class="mt-6 flex flex-wrap gap-3">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm border border-border bg-card hover:border-primary/40 text-foreground transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub Repository
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-sm border border-primary/30 bg-primary/10 text-primary hover:bg-primary/20 transition-colors font-medium"
          >
            Live Demo →
          </a>
        )}
      </div>

      <!-- Tech stack -->
      <div class="mt-6 flex flex-wrap gap-1.5">
        {project.technologies.map((tech) => (
          <span class="font-mono text-xs px-2.5 py-1 bg-muted rounded text-muted-foreground">
            {tech}
          </span>
        ))}
      </div>
    </header>

    <!-- Long Description -->
    {project.longDescription && (
      <section class="mb-12 prose dark:prose-invert max-w-none">
        <h2>About This Project</h2>
        <div class="whitespace-pre-line text-muted-foreground text-sm sm:text-base leading-relaxed">
          {project.longDescription}
        </div>
      </section>
    )}

    <!-- Related Project Logs -->
    {sortedLogs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-border">
        <h2 class="text-xl font-bold text-foreground mb-4">
          Development Logs ({sortedLogs.length})
        </h2>
        <p class="text-sm text-muted-foreground mb-6">
          Chronological progress entries and dev diaries recorded for this project:
        </p>

        <div class="space-y-3">
          {sortedLogs.map((log) => (
            <a
              href={`/project-logs/${log.id}`}
              class="group flex items-center justify-between p-4 rounded-xl border border-border bg-card hover:border-primary/40 transition-colors"
            >
              <div>
                <span class="text-xs font-mono text-muted-foreground block mb-0.5">
                  {log.data.date}
                </span>
                <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">
                  {log.data.title}
                </span>
              </div>
              <span class="text-xs text-primary font-mono group-hover:translate-x-1 transition-transform">
                Read Log →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
