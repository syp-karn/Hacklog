---
import Layout from "@/layouts/Layout.astro";
import { PROJECTS } from "@/data/projects";

const allTags = [...new Set(PROJECTS.flatMap((p) => p.tags))];

const statusBadgeClasses: Record<string, string> = {
  active: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  completed: "bg-sky-500/10 text-sky-400 border-sky-500/20",
  archived: "bg-slate-500/10 text-slate-400 border-slate-500/20",
  wip: "bg-amber-500/10 text-amber-400 border-amber-500/20",
};
---

<Layout
  title="Projects"
  description="Cybersecurity tools, research projects, automated scanners, and security applications built by YOUR NAME."
>
  <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
          PORTFOLIO
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Finished Projects
      </h1>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        Custom security tools, vulnerability scanners, intrusion detection experiments, CTF toolkits, 
        and open-source applications.
      </p>
    </header>

    <!-- Tag Cloud -->
    {allTags.length > 0 && (
      <div class="mb-8 p-4 rounded-xl border border-border bg-card/60">
        <span class="text-xs font-mono font-semibold uppercase text-muted-foreground block mb-2">
          Filter by Tag
        </span>
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="font-mono text-xs px-2.5 py-1 bg-muted/60 hover:bg-primary/20 hover:text-primary rounded-md text-muted-foreground transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {PROJECTS.map((project) => (
        <a
          href={`/projects/${project.slug}`}
          class="group flex flex-col p-6 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-card/80 transition-all"
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">
              {project.title}
            </h2>
            <span
              class={`font-mono text-[10px] uppercase px-2 py-0.5 rounded border shrink-0 ${
                statusBadgeClasses[project.status] || "bg-muted text-muted-foreground"
              }`}
            >
              {project.status}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed flex-1 mb-4">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-border/50">
            {project.technologies.map((tech) => (
              <span class="font-mono text-[10px] px-2 py-0.5 bg-muted/60 rounded text-muted-foreground">
                {tech}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
