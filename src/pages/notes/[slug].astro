---
export const prerender = true;

import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getCollection, render } from "astro:content";
import { mdxComponents } from "@/mdx-components";

export async function getStaticPaths() {
  const posts = await getCollection("notes", ({ data }) => !data.draft);
  const sortedPosts = [...posts].sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost:
        index < sortedPosts.length - 1
          ? { id: sortedPosts[index + 1].id, title: sortedPosts[index + 1].data.title }
          : null,
      nextPost:
        index > 0
          ? { id: sortedPosts[index - 1].id, title: sortedPosts[index - 1].data.title }
          : null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { title, date, summary, tags } = post.data;

const { Content, headings } = await render(post);
---

<ArticleLayout
  title={title}
  date={date}
  summary={summary}
  typeBadge="NOTE"
  typeBadgeColor="bg-sky-500/10 text-sky-400 border-sky-500/20"
  tags={tags}
  headings={headings}
  previousPost={previousPost}
  nextPost={nextPost}
  basePath="/notes"
>
  <Content components={mdxComponents} />
</ArticleLayout>
