---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/utils";

const notes = await getCollection("notes", ({ data }) => !data.draft);
const sortedNotes = notes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allTags = [...new Set(notes.flatMap((n) => n.data.tags))];
---

<Layout
  title="Technical Notes"
  description="Concise technical notes, command references, technique breakdowns, and security explanations."
>
  <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20">
          KNOWLEDGE BASE
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Technical Notes
      </h1>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        Lightweight technical notes, security concepts, command cheatsheets, and technique summaries 
        documented for quick reference and future study.
      </p>
    </header>

    <label for="notes-search" class="sr-only">Search notes</label>
    <input
      id="notes-search"
      type="search"
      placeholder="Search notes..."
      class="w-full mb-4 px-3 py-2 rounded-md border border-border bg-background text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
    />

    <!-- Tag Cloud -->
    {allTags.length > 0 && (
      <div class="mb-8 p-4 rounded-xl border border-border bg-card/60">
        <span class="text-xs font-mono font-semibold uppercase text-muted-foreground block mb-2">
          Filter by Tag
        </span>
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="font-mono text-xs px-2.5 py-1 bg-muted/60 hover:bg-primary/20 hover:text-primary rounded-md text-muted-foreground transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- List -->
    {sortedNotes.length === 0 ? (
      <div class="p-12 text-center border border-dashed border-border rounded-xl">
        <p class="text-muted-foreground text-sm">No notes published yet.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {sortedNotes.map((post) => {
          const { title, date, summary, tags } = post.data;
          return (
            <a
              href={`/notes/${post.id}`}
              data-searchable
              data-search-text={`${title} ${summary} ${tags.join(" ")}`.toLowerCase()}
              class="group block p-5 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-card/80 transition-all"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20">
                  NOTE
                </span>
              </div>

              <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">
                {title}
              </h2>

              <p class="mt-2 text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2">
                {summary}
              </p>

              {tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                    <span class="font-mono text-[10px] px-2 py-0.5 bg-muted/60 rounded text-muted-foreground">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    )}

    <script is:inline>
      const search = document.querySelector("#notes-search");
      const entries = document.querySelectorAll("[data-searchable]");
      search?.addEventListener("input", (event) => {
        const query = event.target.value.trim().toLowerCase();
        entries.forEach((entry) => {
          entry.hidden = query.length > 0 && !entry.dataset.searchText.includes(query);
        });
      });
    </script>
  </div>
</Layout>
