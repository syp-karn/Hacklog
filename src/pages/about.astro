---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/data/site";
---

<Layout
  title="About"
  description={`Biography, experience, certifications, and skills of ${SITE.name}.`}
>
  <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- HEADER with avatar                                              -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <header class="mb-10 pb-8 border-b border-border">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6">
        <!-- Avatar -->
        <div class="shrink-0">
          <img
            src={SITE.avatarUrl}
            alt={`${SITE.name} profile photo`}
            width="96"
            height="96"
            class="size-24 rounded-full object-cover border-2 border-primary/30 ring-4 ring-primary/10"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <!-- Fallback initials avatar -->
          <div
            class="size-24 rounded-full bg-primary/20 text-primary font-bold text-2xl items-center justify-center hidden"
            aria-hidden="true"
          >
            {SITE.initials}
          </div>
        </div>

        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
              ABOUT
            </span>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            {SITE.name}
          </h1>
          {SITE.tagline && (
            <p class="mt-1 text-primary font-mono text-sm">{SITE.tagline}</p>
          )}
        </div>
      </div>
    </header>

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 1. BIOGRAPHY / SUMMARY                                          -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <section class="mb-12 space-y-4 text-muted-foreground leading-relaxed text-sm sm:text-base">
      <p>{SITE.about.summary}</p>
    </section>

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 2. EXPERIENCE                                                    -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-foreground mb-6">Experience</h2>
      <div class="space-y-4">
        {SITE.about.experience.map((exp) => (
          <div class="p-5 rounded-xl border border-border bg-card">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              {exp.logo && (
                <img
                  src={exp.logo}
                  alt={`${exp.company} logo`}
                  class="size-7 rounded object-contain bg-white p-0.5"
                />
              )}
              <div class="flex-1 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                <h3 class="text-base font-semibold text-foreground">
                  {exp.title}
                  <span class="text-muted-foreground font-normal"> at {exp.company}</span>
                </h3>
                <span class="font-mono text-xs text-muted-foreground">{exp.period}</span>
              </div>
            </div>
            {Array.isArray(exp.description) ? (
              <ul class="list-disc list-outside ml-4 mt-2 space-y-1.5 text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {exp.description.map((point) => <li>{point}</li>)}
              </ul>
            ) : (
              exp.description && (
                <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                  {exp.description}
                </p>
              )
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 3. CERTIFICATIONS                                               -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-foreground mb-6">Certifications</h2>
      <div class="space-y-4">
        {SITE.certifications.map((cert) => (
          <div class="p-5 rounded-xl border border-border bg-card flex items-center gap-4">
            {cert.badge && (
              <img
                src={cert.badge}
                alt={`${cert.name} badge`}
                class="size-14 object-contain shrink-0"
              />
            )}
            <div class="flex-1 min-w-0">
              <span class="font-mono text-xs text-primary font-semibold block">{cert.issuer}</span>
              <h3 class="text-sm font-bold text-foreground leading-snug mt-0.5">{cert.name}</h3>
              <span class="font-mono text-xs text-muted-foreground">{cert.date}</span>
            </div>
            {cert.credentialUrl && (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 inline-flex items-center gap-1 text-xs text-primary hover:underline font-mono"
              >
                Verify →
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 4. SKILLS                                                       -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-foreground mb-6">Skills</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {Object.entries(SITE.about.skills).map(([category, items]) => (
          <div class="p-5 rounded-xl border border-border bg-card">
            <h3 class="font-mono text-xs font-semibold uppercase text-primary tracking-wider mb-3">
              {category}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {items.map((skill) => (
                <span class="font-mono text-xs px-2.5 py-1 bg-muted/60 rounded text-muted-foreground">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 5. ACHIEVEMENTS                                                 -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    {SITE.about.achievements.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-foreground mb-6">Achievements</h2>
        <div class="p-5 rounded-xl border border-border bg-card">
          <ul class="space-y-2">
            {SITE.about.achievements.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                <span class="mt-[6px] size-1.5 rounded-full bg-primary shrink-0" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 6. VOLUNTEERING                                                 -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    {SITE.about.volunteering.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-foreground mb-6">Volunteering</h2>
        <div class="space-y-4">
          {SITE.about.volunteering.map((v) => (
            <div class="p-5 rounded-xl border border-border bg-card">
              <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
                <h3 class="text-base font-semibold text-foreground">
                  {v.role}
                  <span class="text-muted-foreground font-normal"> · {v.org}</span>
                </h3>
                <span class="font-mono text-xs text-muted-foreground">{v.period}</span>
              </div>
              {v.description && (
                <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                  {v.description}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- 7. RESUME BUTTON                                                -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <section class="mt-12 p-6 rounded-xl border border-primary/20 bg-primary/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="font-semibold text-foreground">Full Resume / CV</h3>
        <p class="text-xs text-muted-foreground mt-0.5">
          View the complete resume with all details.
        </p>
      </div>
      <a
        href={SITE.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        Open Resume →
      </a>
    </section>
  </div>
</Layout>
