---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/data/site";
---

<Layout
  title="Certifications"
  description={`Cybersecurity certifications, achievements, and credentials held by ${SITE.name}.`}
>
  <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">
    <!-- Header -->
    <header class="mb-10 border-b border-border pb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
          CREDENTIALS
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Certifications & Badges
      </h1>
      <p class="mt-2 text-muted-foreground leading-relaxed">
        Professional cybersecurity certifications, hands-on exams, and technical achievements.
      </p>
    </header>

    <!-- Certifications Grid -->
    <div class="space-y-4">
      {SITE.certifications.map((cert) => (
        <div class="p-6 rounded-xl border border-border bg-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="font-mono text-xs text-primary font-semibold block mb-1">
              {cert.issuer}
            </span>
            <h2 class="text-lg font-bold text-foreground">
              {cert.name}
            </h2>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-muted-foreground tabular-nums">
              {cert.date}
            </span>
            {cert.credentialUrl && (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs text-primary hover:underline font-mono"
              >
                Verify →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
