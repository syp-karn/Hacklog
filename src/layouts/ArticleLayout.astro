---
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { formatDate } from "@/lib/utils";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PostNav {
  id: string;
  title: string;
}

interface Props {
  title: string;
  date: string;
  summary: string;
  typeBadge: string;
  typeBadgeColor?: string;
  tags?: string[];
  metaInfo?: string;
  headings?: Heading[];
  previousPost?: PostNav | null;
  nextPost?: PostNav | null;
  basePath: string; // e.g. "/writeups" or "/research"
}

const {
  title,
  date,
  summary,
  typeBadge,
  typeBadgeColor = "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  tags = [],
  metaInfo,
  headings = [],
  previousPost,
  nextPost,
  basePath,
} = Astro.props;
---

<Layout title={title} description={summary} hasToc={headings.length > 0}>
  <div class="flex flex-1 min-w-0 w-full justify-center">
    <!-- Main article container -->
    <div class="w-full max-w-3xl px-6 py-10 lg:py-14">
      
      <!-- Back button -->
      <div class="mb-6">
        <a
          href={basePath}
          class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors py-1 px-2.5 rounded-md border border-border bg-card"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Back to {basePath.replace("/", "").replace("-", " ")}
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-8 border-b border-border pb-6">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span class={`font-mono text-[10px] font-bold tracking-wider px-2 py-0.5 rounded border ${typeBadgeColor}`}>
            {typeBadge}
          </span>
          {metaInfo && (
            <span class="font-mono text-xs text-muted-foreground">
              · {metaInfo}
            </span>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-foreground leading-tight">
          {title}
        </h1>

        <p class="mt-3 text-sm sm:text-base text-muted-foreground leading-relaxed">
          {summary}
        </p>

        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="font-mono text-[11px] px-2 py-0.5 bg-muted/60 hover:bg-primary/20 hover:text-primary rounded text-muted-foreground transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Mobile / Small screen Table of Contents -->
      {headings.length > 0 && (
        <details class="xl:hidden mb-8 p-4 border border-border rounded-xl bg-card">
          <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-muted-foreground font-mono select-none">
            Table of Contents
          </summary>
          <div class="mt-3">
            <TableOfContents headings={headings} />
          </div>
        </details>
      )}

      <!-- Optional slot for metadata box (e.g. CVE metadata) -->
      <slot name="metadata" />

      <!-- Article Content -->
      <article class="prose max-w-none font-sans leading-relaxed text-muted-foreground dark:prose-invert">
        <slot />
      </article>

      <!-- Pagination / Next-Prev Nav -->
      <nav class="mt-12 pt-8 border-t border-border" aria-label="Article navigation">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {previousPost ? (
            <a
              href={`${basePath}/${previousPost.id}`}
              class="group p-4 rounded-xl border border-border bg-card hover:border-primary/40 transition-colors flex flex-col gap-1"
            >
              <span class="text-[11px] font-mono text-muted-foreground flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
                Previous Article
              </span>
              <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors line-clamp-1">
                {previousPost.title}
              </span>
            </a>
          ) : <div />}

          {nextPost ? (
            <a
              href={`${basePath}/${nextPost.id}`}
              class="group p-4 rounded-xl border border-border bg-card hover:border-primary/40 transition-colors flex flex-col gap-1 sm:text-right"
            >
              <span class="text-[11px] font-mono text-muted-foreground flex items-center justify-start sm:justify-end gap-1">
                Next Article
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </span>
              <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors line-clamp-1">
                {nextPost.title}
              </span>
            </a>
          ) : <div />}
        </div>
      </nav>
    </div>

    <!-- Right Rail Sticky Table of Contents (Desktop XL view) -->
    {headings.length > 0 && (
      <aside class="hidden xl:block w-64 shrink-0 py-14 pr-6 pl-4 border-l border-border/50 sticky top-0 h-screen overflow-y-auto">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</Layout>
