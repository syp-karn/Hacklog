---
import "../styles/global.css";
import { CONFIG } from "@/data/config";
import { SITE } from "@/data/site";
import Sidebar from "@/components/Sidebar.astro";
import MobileNavIsland from "@/components/MobileNavIsland";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL or site-rooted path; falls back to the site-wide OG image */
  image?: string;
  /** Intrinsic dimensions of the custom OG image, when known */
  imageWidth?: number;
  imageHeight?: number;
  canonicalURL?: string;
  /** For article pages: show ToC in right rail */
  hasToc?: boolean;
  /** Utility pages (search, 404) that should stay out of search indexes */
  noindex?: boolean;
}

const {
  title,
  description = CONFIG.seo.defaultDescription,
  image,
  imageWidth,
  imageHeight,
  canonicalURL = Astro.url.href,
  hasToc = false,
  noindex: forceNoindex = false,
} = Astro.props;

// Site-wide default title, or "%s | %n" with the page title when one is given
// (template comes from CONFIG.seo.titleTemplate).
const siteTitle = "Poorvaj's Hacklog";
const pageTitle = title
  ? CONFIG.seo.titleTemplate
      .replace("%s", title)
      .replace("%n", CONFIG.author.name)
  : siteTitle;

// LinkedIn (and other scrapers) require an absolute, publicly reachable og:image
// at least 1200x627 — see https://www.linkedin.com/help/linkedin/answer/a521928
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${CONFIG.site.url}${image}`
  : `${CONFIG.site.url}${CONFIG.seo.ogImage}`;

// og:image.png is 1200x630; custom images carry their intrinsic dimensions
// through from the content collection.
const resolvedImageWidth = imageWidth ?? (image ? undefined : 1200);
const resolvedImageHeight = imageHeight ?? (image ? undefined : 630);

const { light, dark, radius } = CONFIG.theme;

// A preview/staging build must never be indexed: duplicate content competes
// with the real site, and being crawled is the easiest way for a stranger to
// trip over a non-production deployment. Set PUBLIC_NOINDEX=1 for previews.
// Individual pages can also opt out via the noindex prop.
const noindex =
  forceNoindex || import.meta.env.PUBLIC_NOINDEX === "1";
const robotsContent = noindex ? "noindex, nofollow" : CONFIG.seo.robots;
const googlebotContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1";

// Determine active path for sidebar highlighting
const currentPath = Astro.url.pathname;
---

<html
  lang={CONFIG.site.locale.split("_")[0]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC prevention: apply stored theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (
            theme === "dark" ||
            (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (_) {}
      })();
    </script>

    <!-- Theme variables from config.ts -->
    <style
      set:html={`
      :root {
        --radius: ${radius};
        --background: ${light.background};
        --foreground: ${light.foreground};
        --card: ${light.card};
        --card-foreground: ${light.cardForeground};
        --popover: ${light.popover};
        --popover-foreground: ${light.popoverForeground};
        --primary: ${light.primary};
        --primary-foreground: ${light.primaryForeground};
        --secondary: ${light.secondary};
        --secondary-foreground: ${light.secondaryForeground};
        --muted: ${light.muted};
        --muted-foreground: ${light.mutedForeground};
        --accent: ${light.accent};
        --accent-foreground: ${light.accentForeground};
        --destructive: ${light.destructive};
        --border: ${light.border};
        --input: ${light.input};
        --ring: ${light.ring};
        --sidebar-bg: ${CONFIG.theme.sidebar.light.background};
        --sidebar-border: ${CONFIG.theme.sidebar.light.border};
      }
      .dark {
        --background: ${dark.background};
        --foreground: ${dark.foreground};
        --card: ${dark.card};
        --card-foreground: ${dark.cardForeground};
        --popover: ${dark.popover};
        --popover-foreground: ${dark.popoverForeground};
        --primary: ${dark.primary};
        --primary-foreground: ${dark.primaryForeground};
        --secondary: ${dark.secondary};
        --secondary-foreground: ${dark.secondaryForeground};
        --muted: ${dark.muted};
        --muted-foreground: ${dark.mutedForeground};
        --accent: ${dark.accent};
        --accent-foreground: ${dark.accentForeground};
        --destructive: ${dark.destructive};
        --border: ${dark.border};
        --input: ${dark.input};
        --ring: ${dark.ring};
        --sidebar-bg: ${CONFIG.theme.sidebar.dark.background};
        --sidebar-border: ${CONFIG.theme.sidebar.dark.border};
      }
    `}
    ></style>

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots -->
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={googlebotContent} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={CONFIG.site.locale} />
    <meta property="og:image" content={ogImage} />
    {resolvedImageWidth && <meta property="og:image:width" content={String(resolvedImageWidth)} />}
    {resolvedImageHeight && <meta property="og:image:height" content={String(resolvedImageHeight)} />}
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content={CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (Person + WebSite) — helps search engines connect the
         site to the author across both properties. All fields come from the
         site's own data files; nothing is invented. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${CONFIG.site.url}/#person`,
          "name": SITE.name,
          "url": CONFIG.site.url,
          "image": ogImage,
          "jobTitle": CONFIG.author.tagline,
          "description": SITE.description,
          "sameAs": [SITE.linkedin, SITE.github].filter(Boolean),
        },
        {
          "@type": "WebSite",
          "@id": `${CONFIG.site.url}/#website`,
          "url": CONFIG.site.url,
          "name": siteTitle,
          "description": CONFIG.seo.defaultDescription,
          "publisher": { "@id": `${CONFIG.site.url}/#person` },
        },
      ],
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <!--
      Self-hosted, cookieless analytics (see src/lib/tracker + analytics-worker/).
      Passive device signals + behavior; IP is salt-hashed server-side, never stored raw.
    -->
    <script>
      import "@/lib/tracker/main";
    </script>

    <!-- Skip to content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <!-- Mobile nav bar (visible only on mobile) -->
    <div class="lg:hidden fixed top-0 left-0 right-0 z-50 border-b border-border bg-[var(--sidebar-bg)] backdrop-blur-sm">
      <div class="flex items-center justify-between px-4 h-14">
        <a href="/" class="font-mono font-bold text-lg tracking-tight text-primary">
          HACKLOG
        </a>
        <!-- Hamburger button rendered by island; drawer/overlay are body-level siblings below -->
        <div id="mobile-nav-trigger"></div>
      </div>
    </div>

    <!-- MobileNavIsland as a direct body child so its fixed drawer escapes the header's stacking context -->
    <MobileNavIsland currentPath={currentPath} client:load />

    <!-- Page layout: sidebar + main content -->
    <div class="flex min-h-screen">
      <!-- Left sidebar (desktop only) -->
      <aside
        id="sidebar"
        class="hidden lg:flex flex-col w-60 shrink-0 fixed top-0 left-0 h-screen border-r border-[var(--sidebar-border)] bg-[var(--sidebar-bg)] overflow-y-auto z-30"
        aria-label="Main navigation"
      >
        <Sidebar currentPath={currentPath} />
      </aside>

      <!-- Main content area -->
      <div class="flex-1 lg:ml-60 min-w-0">
        <!-- Spacer for mobile top bar -->
        <div class="h-14 lg:hidden" aria-hidden="true"></div>

        <main id="main-content" class={hasToc ? "flex gap-0" : ""}>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
